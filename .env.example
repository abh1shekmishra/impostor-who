# Copy to `.env` and fill in. All keys are build-time (Vite `VITE_` prefix) and
# ship in the client bundle, so only use client-safe, write-only keys here.

# PostHog product analytics (optional — the app runs fine without it).
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_POSTHOG_HOST=https://us.i.posthog.com
